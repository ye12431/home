<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="house.springboot.Mapper.HouseImageMapper">
    <!-- namespace：必须和 Mapper 接口全类名一致 -->

    <insert id="batchInsert">
        insert into `house_image` (house_id,url) values
        <foreach collection="imageUrls" item="url" separator=",">
            (#{houseId},#{url})
        </foreach>
    </insert>

    <delete id="deleteByHouseId">
        delete from `house_image` where house_id = #{houseId}
    </delete>

</mapper>
