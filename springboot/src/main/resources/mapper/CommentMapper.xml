<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="house.springboot.Mapper.CommentMapper">
    <insert id="insertComment">
        insert into `comment`(house_id, user_id, user_name, content, rating)
        value(#{houseId},#{userId},#{userName},#{content},#{rating})
    </insert>
    <select id="selectCommentById">
        select *from `comment` where house_id =#{houseId}
    </select>
    <delete id="deleteCommentById">
        delete from `comment` where id = #{id}
    </delete>
</mapper>